# Copy to .env.local for `npm run dev`. All three are public values (they end up in the browser).
NEXT_PUBLIC_API_URL=https://tawasol.yourmedicalway.com
# Supabase > Project Settings > API: Project URL and the anon / publishable key (not the service role key).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
