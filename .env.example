# Copy to .env and fill in. Never commit the real .env.

# Supabase Postgres connection string (Project Settings > Database > Connection string).
# Use the pooler URI if your host cannot reach the direct port.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres

# Supabase API (only needed if the backend calls the Supabase REST/Auth APIs)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Doctor collector (backend/jobs/daily_check.py)
# OpenStreetMap: free, no key. "all" searches all 27 governorates.
OSM_ENABLED=true
OSM_GOVERNORATES=all
OSM_EVERY_DAYS=1
STALE_AFTER_MISSES=3

# Google Places: optional and paid. Leave the key empty to keep it off.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_REQUESTS=200
GOOGLE_PLACES_GOVERNORATES=cairo,giza,alexandria
GOOGLE_DISCOVERY_EVERY_DAYS=7
GOOGLE_REFRESH_EVERY_DAYS=7
