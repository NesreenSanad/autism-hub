# Copy to .env and fill in. Never commit the real .env.

# Supabase Postgres connection string (Project Settings > Database > Connection string).
# Use the pooler URI if your host cannot reach the direct port.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres

# Supabase API (only needed if the backend calls the Supabase REST/Auth APIs)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Admin page login: the public "anon" key (Project Settings > API) and the emails
# allowed to review places, comma-separated. Each admin needs a Supabase Auth user.
SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# App
APP_ENV=development
# Comma-separated; add the address the web app is served from.
CORS_ORIGINS=http://localhost:3000

# Doctor collector (backend/jobs/daily_check.py)
# Automatic sources: osm (OpenStreetMap, free), google (Google Places, paid, needs the key below),
# or both: osm,google
COLLECTOR_SOURCES=osm
# OpenStreetMap: "all" searches all 27 governorates.
OSM_GOVERNORATES=all
OSM_EVERY_DAYS=1
# Optional: Overpass servers to try in turn, comma-separated. Empty uses
# overpass-api.de, overpass.kumi.systems, overpass.private.coffee and maps.mail.ru.
OVERPASS_URLS=
# overpass (ask the servers above) or extract (download Egypt from Geofabrik; needs
# the osmium command and the shapely package, used by the GitHub workflow).
OSM_METHOD=overpass
STALE_AFTER_MISSES=3

# Google Places: used only when COLLECTOR_SOURCES includes google.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_REQUESTS=200
GOOGLE_PLACES_GOVERNORATES=cairo,giza,alexandria
GOOGLE_DISCOVERY_EVERY_DAYS=7
GOOGLE_REFRESH_EVERY_DAYS=7
